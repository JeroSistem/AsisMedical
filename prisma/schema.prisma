// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?  // Campo para contraseña hasheada
  role      UserRole
  status    String   @default("Active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campos para NextAuth.js
  emailVerified DateTime?
  image         String?

  // Relaciones para NextAuth.js
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Patient {
  id           String          @id @default(uuid())
  name         String
  dateOfBirth  DateTime        @map("date_of_birth")
  gender       String
  contact      String?
  address      String?
  avatarUrl    String?         @map("avatar_url")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")
  
  medicalRecords MedicalRecord[]
  triages       Triage[]

  @@map("patients")
}

model MedicalRecord {
  id            String           @id @default(uuid())
  patientId     String           @map("patient_id")
  medicalHistory String?         @map("medical_history")
  currentStatus String?          @map("current_status")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")
  
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnoses     Diagnosis[]
  treatments    Treatment[]
  documents     MedicalDocument[]

  @@map("medical_records")
}

model Diagnosis {
  id              String        @id @default(uuid())
  medicalRecordId String        @map("medical_record_id")
  date            DateTime
  code            String
  description     String
  physician       String
  createdAt       DateTime      @default(now()) @map("created_at")
  
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Treatment {
  id              String        @id @default(uuid())
  medicalRecordId String        @map("medical_record_id")
  date            DateTime
  procedure       String
  medication      String?
  dosage          String?
  physician       String
  createdAt       DateTime      @default(now()) @map("created_at")
  
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("treatments")
}

model MedicalDocument {
  id              String        @id @default(uuid())
  medicalRecordId String        @map("medical_record_id")
  date            DateTime
  type            String
  title           String
  url             String?
  createdAt       DateTime      @default(now()) @map("created_at")
  
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("medical_documents")
}

model Triage {
  id              String   @id @default(uuid())
  patientId       String?  @map("patient_id")
  arrivalTime     DateTime @map("arrival_time")
  vitalSigns      Json?    @map("vital_signs")
  consciousnessLevel String? @map("consciousness_level")
  painLevel       Int?     @map("pain_level")
  urgencyLevel    String   @map("urgency_level")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  
  patient         Patient? @relation(fields: [patientId], references: [id])

  @@map("triage")
}

// Modelos para NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  Administrador
  Médico
  Enfermero
  Paciente
}

# Copiar a .env.local: cp env.local.example .env.local

# NextAuth
NEXTAUTH_URL=http://localhost:9002
NEXTAUTH_SECRET=your-secret-key-here-change-in-production-min-32-chars

# MySQL local (o docker compose: host db en lugar de 127.0.0.1)
DATABASE_URL=mysql://asis:asis_mysql_dev@127.0.0.1:3306/asis_medical

# Admin plataforma (scripts/db:create-platform-admin)
PLATFORM_ADMIN_USERNAME=AsisMedical
PLATFORM_ADMIN_PASSWORD=cambiar-password-seguro
PLATFORM_ADMIN_EMAIL=admin@asismedical.com
PLATFORM_ADMIN_NAME=Administrador Principal ASIS Medical

# Desarrollo
AUTH_DEV_FALLBACK=true
NODE_ENV=development

# Idioma
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_AVAILABLE_LOCALES=es
NEXT_PUBLIC_FORCE_SPANISH=true

# Google AI (Genkit) - opcional
GOOGLE_AI_API_KEY=
